# ============================================================
#  Nexus Logistics – Root .env.example
# ============================================================

# ── Environment ──────────────────────────────────────────────
APP_ENV=development          # development | staging | production

# ── Backend API ──────────────────────────────────────────────
BACKEND_PORT=8080
JWT_SECRET=change_me_to_a_64_char_random_secret
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_HOURS=168

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgres://nexus:change_me_strong_password@localhost:5432/nexus?sslmode=disable

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Blockchain / Ethereum ─────────────────────────────────────
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
ETHEREUM_CHAIN_ID=11155111
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here
SHIPMENT_CONTRACT_ADDRESS=0x_deployed_contract_address

# ── Optimizer Service ─────────────────────────────────────────
OPTIMIZER_HOST=localhost
OPTIMIZER_PORT=9090

# ── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
VITE_CHAIN_ID=11155111

# ── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=info

# ── Admin bootstrap (only used on first startup if no admin exists) ───────────
ADMIN_EMAIL=admin@nexus-logistics.com
ADMIN_PASSWORD=change_me_strong_admin_password
MIGRATIONS_PATH=/app/migrations   # override in Docker; defaults to ../../migrations relative to binary
